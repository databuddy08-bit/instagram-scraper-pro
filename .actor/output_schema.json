{
    "actorOutputSchemaVersion": 1,
    "title": "Instagram Scraper Pro output",
    "properties": {
        "posts": {
            "type": "string",
            "title": "Posts & reels",
            "template": "{{links.apiDefaultDatasetUrl}}/items?view=overview"
        },
        "comments": {
            "type": "string",
            "title": "Comments",
            "template": "{{links.apiDefaultDatasetUrl}}/items?view=comments"
        },
        "profiles": {
            "type": "string",
            "title": "Profiles",
            "template": "{{links.apiDefaultDatasetUrl}}/items?view=profiles"
        },
        "failed": {
            "type": "string",
            "title": "Failed inputs (free)",
            "template": "{{links.apiDefaultDatasetUrl}}/items?view=failed"
        },
        "runSummary": {
            "type": "string",
            "title": "Run summary (per input: saved, skipped and why)",
            "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/RUN_SUMMARY"
        },
        "diagnostics": {
            "type": "string",
            "title": "Diagnostics (which Instagram methods worked)",
            "template": "{{links.apiDefaultKeyValueStoreUrl}}/records/DIAGNOSTICS"
        }
    }
